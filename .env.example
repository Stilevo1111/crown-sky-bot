# Скопируйте в .env и заполните своими данными

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Username бота без @
BOT_USERNAME=crown_sky_bot

# Публичный адрес сервиса (без завершающего слеша)
PUBLIC_URL=https://bot-2bdu.onrender.com

# Строка подключения Neon (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/crownsky?sslmode=require

# Секрет для проверки вебхука Telegram (можно сгенерировать случайной строкой)
WEBHOOK_SECRET=change-me-to-random-string

# Ставить вебхук автоматически при старте (true/false)
SET_WEBHOOK=true

# ID администраторов через запятую — им доступны /news_add и /post
ADMIN_IDS=123456789

# Необязательно: чат/канал для /post. Можно не заполнять — достаточно /connect в группе
GROUP_CHAT_ID=

# Порт (Render сам задаёт PORT)
PORT=10000
